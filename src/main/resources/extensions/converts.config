---
code: converts
description: Type conversions for common types (Date, ObjectId, etc.)
default-enabled: true
---

# ─── Non-basic time / identity value types ───────────────────────────────────
#
# These types are not JSON-native. Left alone they would be documented as
# objects (`java.time.Duration` → `{seconds, nanos}`, `java.util.UUID` →
# `{mostSigBits, leastSigBits}`), so they must be mapped to a scalar.
#
# The mapping lives HERE, as ordinary convert rules, and not in Kotlin: turn
# this extension off (Settings → Rule File → Extensions) and declare your own
# mapping instead — e.g. `json.rule.convert[java.time.Duration]=long` for a
# custom serializer, or `=date` / `=datetime` to keep the OpenAPI
# `format: date` / `format: date-time` on the schema.
#
# The type resolver honours this same declaration when it decides whether a type
# may be expanded into an object, so a field of a listed type keeps its scalar
# shape even as a container element (`List<java.util.Date>` → array of string);
# it is one table, consulted by both the field-level engine and the resolver.
json.rule.convert[java.util.Date]=java.lang.String
json.rule.convert[java.sql.Date]=java.lang.String
json.rule.convert[java.sql.Time]=java.lang.String
json.rule.convert[java.sql.Timestamp]=java.lang.String
json.rule.convert[java.util.Calendar]=java.lang.String
json.rule.convert[java.util.GregorianCalendar]=java.lang.String
json.rule.convert[java.util.UUID]=java.lang.String
json.rule.convert[java.time.LocalDate]=java.lang.String
json.rule.convert[java.time.LocalTime]=java.lang.String
json.rule.convert[java.time.LocalDateTime]=java.lang.String
json.rule.convert[java.time.OffsetTime]=java.lang.String
json.rule.convert[java.time.OffsetDateTime]=java.lang.String
json.rule.convert[java.time.ZonedDateTime]=java.lang.String
json.rule.convert[java.time.Instant]=java.lang.String
json.rule.convert[java.time.Duration]=java.lang.String
json.rule.convert[java.time.Period]=java.lang.String
json.rule.convert[java.time.Year]=java.lang.String
json.rule.convert[java.time.YearMonth]=java.lang.String
json.rule.convert[java.time.MonthDay]=java.lang.String
json.rule.convert[java.time.ZoneId]=java.lang.String
json.rule.convert[java.time.ZoneOffset]=java.lang.String
json.rule.convert[org.joda.time.DateTime]=java.lang.String
json.rule.convert[org.joda.time.LocalDate]=java.lang.String
json.rule.convert[org.joda.time.LocalDateTime]=java.lang.String
json.rule.convert[org.joda.time.LocalTime]=java.lang.String
json.rule.convert[org.joda.time.Duration]=java.lang.String
json.rule.convert[org.joda.time.Period]=java.lang.String

# ─── Other common value types ────────────────────────────────────────────────
json.rule.convert[org.bson.types.ObjectId]=java.lang.String
json.rule.convert[java.math.BigInteger]=java.lang.Long
json.rule.convert[java.net.URL]=java.lang.String
json.rule.convert[java.util.concurrent.atomic.AtomicBoolean]=java.lang.Boolean
json.rule.convert[java.util.concurrent.atomic.AtomicLong]=java.lang.Long
json.rule.convert[java.util.concurrent.atomic.AtomicInteger]=java.lang.Integer
