---
code: swagger
description: Swagger 2.x annotation support
on-class: io.swagger.annotations.Api
default-enabled: true
---

# Api
class.doc=@io.swagger.annotations.Api#value
class.doc=@io.swagger.annotations.Api#tags
ignore=@io.swagger.annotations.Api#hidden

# ApiModel
class.doc=@io.swagger.annotations.ApiModel#value
class.doc=@io.swagger.annotations.ApiModel#description

# ApiModelProperty
json.rule.field.name=@io.swagger.annotations.ApiModelProperty#name
field.ignore=@io.swagger.annotations.ApiModelProperty#hidden
field.doc=@io.swagger.annotations.ApiModelProperty#value
field.doc=@io.swagger.annotations.ApiModelProperty#notes
field.required=@io.swagger.annotations.ApiModelProperty#required
field.demo=@io.swagger.annotations.ApiModelProperty#example

# ApiParam
param.doc=@io.swagger.annotations.ApiParam#value
param.default.value=@io.swagger.annotations.ApiParam#defaultValue
param.required=@io.swagger.annotations.ApiParam#required
param.ignore=@io.swagger.annotations.ApiParam#hidden
param.demo=@io.swagger.annotations.ApiParam#example

# ApiOperation
method.doc=@io.swagger.annotations.ApiOperation#value
method.doc=@io.swagger.annotations.ApiOperation#notes
ignore=@io.swagger.annotations.ApiOperation#hidden
method.default.http.method=@io.swagger.annotations.ApiOperation#httpMethod

# resolve the parameters from ApiImplicitParam
resolve_swagger_implicit_param=```
    if(map == null) return
    def desc = map.value
    def paramType = map.paramType ?: "query"
    def required = map.required == null ? false : map.required
    def defaultValue = map.defaultValue
    if(paramType==""||paramType=="query"){
        api.setParam(map.name,defaultValue,required,desc,null)
    }else if(paramType=="form"){
        api.setFormParam(map.name,defaultValue,required,desc,null)
    }else if(paramType=="path"){
        api.setPathParam(map.name,defaultValue,desc,null)
    }else if(paramType=="header"){
        api.setHeader(map.name,defaultValue,required,desc,null)
    }
```

# extract parameter from ApiImplicitParam
export.after[@io.swagger.annotations.ApiImplicitParam]=groovy:```
    def map = it.annMap("io.swagger.annotations.ApiImplicitParam")
    ${resolve_swagger_implicit_param}
```

# extract parameters from ApiImplicitParams
export.after[@io.swagger.annotations.ApiImplicitParams]=groovy:```
    def maps = it.annMap("io.swagger.annotations.ApiImplicitParams")
    if(maps == null || maps.value == null) return
    for(map in maps.value){
        ${resolve_swagger_implicit_param}
    }
```

# resolve the response from ApiResponse
#
# Only `code` and `message` are carried — they are what `@ApiResponse` declares,
# and they land in the endpoint description, which every channel renders.
#
# `responseHeaders` is deliberately NOT routed through `api.setResponseHeader`.
# That setter appends to `HttpMetadata.headers`, the SAME list that feeds the
# request headers and the only one the YApi envelope has a field for; pushing
# response headers there would render them as request headers. It stays out
# until the two get separate buckets.
#
# `response` is skipped because `response()` defaults to `Void.class`, so
# honouring it would overwrite the response type inferred from the method's
# return type whenever the annotation omits it.
resolve_swagger_api_response=```
    if(map == null) return
    def message = map.message
    if(message == null || message.toString().isEmpty()) return
    api.appendDesc("\n\n**response " + map.code + "**: " + message)
```

# extract response from ApiResponse
export.after[@io.swagger.annotations.ApiResponse]=groovy:```
    def map = it.annMap("io.swagger.annotations.ApiResponse")
    ${resolve_swagger_api_response}
```

# extract responses from ApiResponses
export.after[@io.swagger.annotations.ApiResponses]=groovy:```
    def maps = it.annMap("io.swagger.annotations.ApiResponses")
    if(maps == null || maps.value == null) return
    for(map in maps.value){
        ${resolve_swagger_api_response}
    }
```
